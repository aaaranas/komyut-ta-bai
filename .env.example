# Komyut ta Bai — environment variables. Copy to .env.local for local development.
# Everything is optional locally: with nothing set, the app runs in dev mode on the JSON store.

# ── Identity ────────────────────────────────────────────────────────────────
# Salt for hashing ids into pseudonyms and identity hashes. REQUIRED on any shared deployment;
# keep it stable (changing it orphans every pseudonym). Generate: openssl rand -hex 32
KOMYUT_PSEUDONYM_SALT=

# ── Google sign-in (Auth.js) ────────────────────────────────────────────────
# Sign-in is on only when all three are set; otherwise "dev mode" (device pseudonyms).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Comma-separated researcher emails allowed into /lab when sign-in is on.
KOMYUT_RESEARCHER_EMAILS=
# Shared key for /lab when sign-in is OFF (dev mode). Ignored when sign-in is on.
KOMYUT_LAB_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (e.g. Neon). When unset, the JSON file store is used.
# Neon: use the POOLED connection string here…
DATABASE_URL=
# …and the DIRECT (unpooled) one here, used only by `prisma migrate`.
DIRECT_URL=
# JSON store directory for local development (default ./.data).
KOMYUT_DATA_DIR=

# ── Hazard and weather sources ──────────────────────────────────────────────
# Set to "off" to skip the Open-Meteo rainfall forecast (offline development).
KOMYUT_WEATHER=
# PhilSensors adapter stub: "true" lists it (always "not connected" until access is granted).
KOMYUT_ENABLE_PHILSENSORS=
PHILSENSORS_API_KEY=
